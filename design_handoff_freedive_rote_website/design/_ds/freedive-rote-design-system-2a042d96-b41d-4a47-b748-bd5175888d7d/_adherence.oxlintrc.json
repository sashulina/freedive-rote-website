        "selector": "JSXOpeningElement[name.name='InfoList'] > JSXAttribute > JSXIdentifier[name!=/^(?:items|tone|columns|style|key|ref|className|style|children)$/]",
        "message": "<InfoList> doesn't accept that prop. Declared props: items, tone, columns, style."
