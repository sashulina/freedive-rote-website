---
import type { CollectionEntry } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import PageBanner from './PageBanner.astro';
import Photo from './Photo.astro';
import Badge from './Badge.astro';
import Button from './Button.astro';
import IncludesBand from './IncludesBand.astro';
import ReviewQuote from './ReviewQuote.astro';
import { SITE } from '../data/site';

/* Shared template for Try Freediving, Level 1–3 and Coaching.
   Content comes from src/content/courses/<slug>.md. */
interface Props { entry: CollectionEntry<'courses'> }
const { entry } = Astro.props;
const d = entry.data;

// Intro body: blocks separated by a blank line; "## " starts a heading.
const blocks = (entry.body ?? '')
  .trim()
  .split(/\n\s*\n/)
  .map((b) => b.trim().replace(/\s*\n\s*/g, ' '))
  .filter(Boolean)
  .map((b) => (b.startsWith('## ') ? { type: 'h2' as const, text: b.slice(3) } : { type: 'p' as const, text: b }));
const split = !!d.intro.photo;
---
<BaseLayout title={d.seoTitle} description={d.description} ogImage={d.banner.image} ogImageAlt={d.banner.alt}>
  <PageBanner image={d.banner.image} alt={d.banner.alt} position={d.banner.position} eyebrow={d.eyebrow} title={d.title} />

  {split ? (
    <section class="intro">
      <div class="container intro__split">
        <div class="intro__text" data-reveal>
          {blocks.map((b) => (b.type === 'h2' ? <h2 class="intro__heading">{b.text}</h2> : <p class="t-lede">{b.text}</p>))}
          <div class="badges">{d.intro.badges.map((b) => <Badge tone={b.tone}>{b.label}</Badge>)}</div>
        </div>
        <figure class="photo intro__photo" data-reveal data-reveal-delay="100">
          <Photo src={d.intro.photo!.image} alt={d.intro.photo!.alt} position={d.intro.photo!.position} widths={[480, 720, 1040, 1300, 1600]} sizes="(max-width: 900px) min(calc(100vw - 40px), 520px), 520px" box={0.8} />
        </figure>
      </div>
    </section>
  ) : (
    <section class="intro">
      <div class="container container--narrow intro__narrow">
        {blocks.map((b, i) => (b.type === 'h2'
          ? <h2 class="intro__heading" data-reveal data-reveal-delay={i ? i * 60 : undefined}>{b.text}</h2>
          : <p class="t-lede" data-reveal data-reveal-delay={i ? i * 60 : undefined}>{b.text}</p>))}
        <div class="badges" data-reveal data-reveal-delay="100">{d.intro.badges.map((b) => <Badge tone={b.tone}>{b.label}</Badge>)}</div>
      </div>
    </section>
  )}

  <IncludesBand
    eyebrow={d.includes.eyebrow}
    heading={d.includes.heading}
    image={d.includes.photo.image}
    alt={d.includes.photo.alt}
    position={d.includes.photo.position}
    items={d.includes.items}
    compact={d.includes.compact}
    align={d.includes.align}
  />

  <section class="details">
    <div class="container container--narrow details__inner">
      {d.details.kind === 'row' && (
        <div class="fact-row">
          <span class="fact-label">{d.details.label}</span>
          <span class="fact-value">{d.details.value}</span>
        </div>
      )}
      {d.details.kind === 'block' && (
        <div class="fact-block" data-reveal>
          <span class="fact-label">{d.details.label}</span>
          <p class="t-body">{d.details.text}</p>
        </div>
      )}
      {d.details.kind === 'note' && <p class="t-body" data-reveal>{d.details.text}</p>}
      <div class="cta-row">
        <Button variant="sand" size="cta" href={SITE.whatsappUrl} external>{d.ctaLabel}</Button>
        <Button variant="secondary" href="/courses">All courses</Button>
      </div>
    </div>
  </section>

  {d.quote && (
    <ReviewQuote
      text={d.quote.text}
      name={d.quote.name}
      size={d.quote.size}
      maxWidth={d.quote.maxWidth}
      paddingTop={d.quote.paddingTop}
      paddingBottom={d.quote.paddingBottom}
    />
  )}
</BaseLayout>

<style>
  .intro { padding-block: clamp(56px, 6vw, 96px) clamp(32px, 4vw, 52px); }
  .intro__split {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
    gap: clamp(36px, 5vw, 80px);
    align-items: center;
  }
  .intro__text { display: flex; flex-direction: column; gap: var(--space-8); min-width: 0; }
  .intro__text .t-lede { max-width: var(--measure-text); }
  .intro__text .t-lede:first-of-type { max-width: var(--measure-lede); }
  .intro__heading {
    margin: 0;
    font-family: var(--font-heading-alt);
    font-weight: var(--weight-light);
    font-size: var(--text-display-2);
    line-height: var(--leading-heading);
    letter-spacing: var(--tracking-heading);
    color: var(--c-ink);
    max-width: 18ch;
  }
  .intro__photo { aspect-ratio: 4 / 5; max-width: 520px; width: 100%; justify-self: end; }
  .intro__narrow { display: flex; flex-direction: column; gap: clamp(28px, 3.5vw, 40px); }
  .intro__narrow .t-lede + .t-lede { max-width: var(--measure-text); }
  .badges { display: flex; flex-wrap: wrap; gap: var(--space-3); }

  .details { padding-block: clamp(48px, 6vw, 88px); }
  .details__inner { display: flex; flex-direction: column; gap: var(--space-8); }
  .fact-row {
    display: flex;
    justify-content: space-between;
    gap: var(--space-6);
    padding-block: var(--space-4);
    border-bottom: var(--border-hair);
  }
  .fact-block {
    display: flex;
    flex-direction: column;
    gap: var(--space-4);
    padding-block: var(--space-5);
    border-top: var(--border-hair);
    border-bottom: var(--border-hair);
  }
  .fact-label {
    font-size: var(--text-eyebrow);
    letter-spacing: var(--tracking-eyebrow);
    text-transform: uppercase;
    color: var(--c-ink-muted);
  }
  .fact-value { font-family: var(--font-heading-alt); font-size: var(--text-body-lg); color: var(--c-ink); }
  .cta-row { display: flex; justify-content: center; flex-wrap: wrap; gap: var(--space-4); padding-top: var(--space-2); }

  @media (max-width: 900px) {
    .intro__split { grid-template-columns: 1fr; }
  }
</style>
