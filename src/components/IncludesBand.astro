---
import type { ImageMetadata } from 'astro';
import Eyebrow from './Eyebrow.astro';
import DashList from './DashList.astro';
import Photo from './Photo.astro';

/* Cream band: centred heading row across the top, then a square photo beside a
   hairline-ruled list. "spread" stretches the list to the photo's height;
   "center" (Coaching) centres a short list against the photo. */
interface Props {
  eyebrow: string;
  heading: string;
  image: ImageMetadata;
  alt: string;
  position?: string;
  items: string[];
  compact?: boolean;
  align?: 'spread' | 'center';
}
const { eyebrow, heading, image, alt, position, items, compact = false, align = 'spread' } = Astro.props;
---
<section class="includes" aria-labelledby="includes-title">
  <div class="container includes__grid">
    <div class="includes__head" data-reveal>
      <Eyebrow>{eyebrow}</Eyebrow>
      <h2 class="t-heading-1 includes__title" id="includes-title">{heading}</h2>
      <span class="sand-rule" aria-hidden="true"></span>
    </div>
    <figure class="photo includes__photo" data-reveal data-reveal-delay="60">
      <Photo src={image} alt={alt} position={position} widths={[440, 660, 880, 1100, 1320, 1650]} sizes="(max-width: 900px) calc(100vw - 40px), 440px" box={1} />
    </figure>
    <DashList items={items} compact={compact} class={`includes__list includes__list--${align}`} revealDelay={100} />
  </div>
</section>

<style>
  .includes { padding-block: clamp(48px, 6vw, 88px); background: var(--surface-sand); }
  .includes__grid {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
    grid-template-rows: auto 1fr;
    gap: clamp(28px, 4vw, 80px);
    align-items: start;
  }
  .includes__head {
    grid-area: 1 / 1 / 2 / 3;
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    gap: var(--space-5);
    min-width: 0;
    padding-bottom: clamp(8px, 2vw, 24px);
  }
  .includes__title { max-width: none; white-space: nowrap; }
  .includes__photo { grid-area: 2 / 1 / 3 / 2; aspect-ratio: 1 / 1; max-width: 440px; width: 100%; }
  .includes :global(.includes__list) { grid-area: 2 / 2 / 3 / 3; }
  .includes :global(.includes__list--spread) { justify-content: space-between; height: 100%; }
  .includes :global(.includes__list--center) { align-self: center; }

  @media (max-width: 900px) {
    .includes__grid { grid-template-columns: 1fr; grid-template-rows: auto; }
    .includes__head,
    .includes__photo,
    .includes :global(.includes__list) { grid-area: auto; }
    .includes__title { white-space: normal; }
  }
</style>
