---
/* Design-system Badge: pill, 13px Jost 400 uppercase, 0.06em tracking. */
interface Props { tone?: 'sand' | 'aqua' | 'outline' | 'onPhoto' }
const { tone = 'sand' } = Astro.props;
---
<span class:list={['badge', `badge--${tone}`]}><slot /></span>

<style>
  .badge {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    padding: 6px 14px;
    border-radius: var(--radius-pill);
    border: 1px solid transparent;
    font-family: var(--font-sans);
    font-size: var(--text-caption);
    font-weight: var(--weight-regular);
    letter-spacing: .06em;
    text-transform: uppercase;
    line-height: 1.3;
  }
  .badge--sand { background: var(--surface-sand-strong); color: var(--c-ink); }
  .badge--aqua { background: var(--c-aqua-wash); color: var(--c-blue-deep); }
  .badge--outline { background: transparent; color: var(--text-body); border-color: var(--border-hairline-strong); }
  .badge--onPhoto {
    background: rgba(11, 51, 72, .58);
    color: var(--text-on-dark);
    border-color: rgba(255, 255, 255, .34);
    -webkit-backdrop-filter: var(--blur-glass);
    backdrop-filter: var(--blur-glass);
  }
</style>
