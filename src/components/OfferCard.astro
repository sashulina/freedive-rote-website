---
import type { ImageMetadata } from 'astro';
import Photo from './Photo.astro';
import Button from './Button.astro';

/* Photo-led card used for Home "What we offer" (variant "offer") and the
   Courses page (variant "course"). On hover (and while pressed on touch) only
   the image zooms to 1.04 over 600ms and the veil deepens from .18 to .30. */
interface Props {
  href: string;
  image: ImageMetadata;
  alt: string;
  position?: string;
  title: string;
  text: string;
  badge?: string;
  variant?: 'offer' | 'course';
  revealDelay?: number;
}
const { href, image, alt, position, title, text, badge, variant = 'offer', revealDelay } = Astro.props;
---
<article class:list={['card', `card--${variant}`]} data-reveal data-reveal-delay={revealDelay || undefined}>
  <a href={href} class="card__media" tabindex="-1" aria-hidden="true" data-press>
    <Photo src={image} alt={alt} widths={[400, 640, 900, 1280]} sizes="(max-width: 900px) calc(100vw - 40px), 600px" position={position} class="card__img" />
    <span class="card__veil"></span>
    {badge && <span class="card__badge">{badge}</span>}
  </a>
  <div class="card__body">
    <h3 class="card__title">{title}</h3>
    <p class="card__text">{text}</p>
    <div class="card__action">
      <Button variant="sand" href={href}>Learn more<span class="sr-only"> about {title}</span></Button>
    </div>
  </div>
</article>

<style>
  .card {
    min-width: 0;
    background: var(--surface-card);
    border-radius: var(--radius-xl);
    overflow: hidden;
    box-shadow: var(--shadow-hairline);
  }
  .card--offer { display: grid; grid-template-columns: minmax(0, 1fr); grid-template-rows: auto 1fr; }
  .card--course { display: flex; flex-direction: column; border: var(--border-hair); }

  .card__media {
    position: relative;
    display: block;
    overflow: hidden;
    aspect-ratio: 3 / 2;
    width: 100%;
    min-width: 0;
    background: var(--c-blue-wash);
    border: 0;
    text-decoration: none;
  }
  .card :global(.card__img) {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    max-width: none;
    object-fit: cover;
    transform: scale(1);
    transition: transform 600ms var(--ease-tide);
  }
  .card__veil {
    position: absolute;
    inset: 0;
    background: rgba(15, 36, 48, .18);
    transition: background 600ms var(--ease-tide);
  }
  @media (hover: hover) {
    .card__media:hover :global(.card__img) { transform: scale(1.04); }
    .card__media:hover .card__veil { background: rgba(15, 36, 48, .3); }
  }
  .card__media.is-pressed :global(.card__img) { transform: scale(1.04); }
  .card__media.is-pressed .card__veil { background: rgba(15, 36, 48, .3); }
  @media (prefers-reduced-motion: reduce) {
    .card__media :global(.card__img) { transform: none !important; }
  }

  .card__badge {
    position: absolute;
    top: var(--space-5);
    left: var(--space-5);
    display: inline-flex;
    align-items: center;
    padding: 6px 14px;
    border-radius: var(--radius-pill);
    border: 1px solid rgba(255, 255, 255, .34);
    background: rgba(11, 51, 72, .58);
    -webkit-backdrop-filter: var(--blur-glass);
    backdrop-filter: var(--blur-glass);
    color: var(--text-on-dark);
    font-family: var(--font-sans);
    font-size: var(--text-caption);
    font-weight: var(--weight-regular);
    letter-spacing: .06em;
    text-transform: uppercase;
    line-height: 1.3;
  }

  .card__body { display: flex; flex-direction: column; min-width: 0; }
  .card--offer .card__body { gap: var(--space-6); padding: clamp(28px, 3.5vw, 52px); }
  .card--course .card__body { gap: var(--space-5); flex: 1; padding: clamp(24px, 3vw, 36px); }

  .card__title {
    margin: 0;
    font-family: var(--font-heading-alt);
    font-weight: var(--weight-light);
    font-size: var(--text-heading-1);
    line-height: var(--leading-heading);
    letter-spacing: var(--tracking-heading);
    color: var(--c-ink);
  }
  .card__text {
    margin: 0;
    font-size: var(--text-body);
    line-height: var(--leading-body);
    color: var(--c-ink-soft);
  }
  .card--offer .card__text { max-width: 44ch; }
  .card--course .card__text { flex: 1; }

  .card__action {
    display: flex;
    justify-content: center;
    padding-top: var(--space-6);
    border-top: var(--border-hair);
  }
  .card--offer .card__action { margin-top: auto; }
</style>

<script>
  // Touch: show the hover state while a card image is pressed.
  document.querySelectorAll<HTMLElement>('[data-press]').forEach((el) => {
    const on = () => el.classList.add('is-pressed');
    const off = () => el.classList.remove('is-pressed');
    el.addEventListener('touchstart', on, { passive: true });
    el.addEventListener('touchend', off);
    el.addEventListener('touchcancel', off);
  });
</script>
