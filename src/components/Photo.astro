---
/* Responsive photo: AVIF + WebP sources with a JPEG fallback, lazy by default.
   `position` keeps the prototype's object-position crop exactly. */
import type { ImageMetadata } from 'astro';
import { Picture } from 'astro:assets';

interface Props {
  src: ImageMetadata;
  alt: string;
  widths?: number[];
  sizes?: string;
  position?: string;
  eager?: boolean;
  /** Encoder quality (1–100). Omit for Astro's defaults. */
  quality?: number;
  class?: string;
}
const { src, alt, widths, sizes = '100vw', position, eager = false, quality, class: cls } = Astro.props;
const w = (widths ?? [480, 800, 1200, 1600, 2000]).filter((x) => x <= src.width);
if (!w.includes(src.width) && src.width < Math.max(...(widths ?? [2000]))) w.push(src.width);
---
<Picture
  src={src}
  alt={alt}
  formats={['avif', 'webp']}
  fallbackFormat="jpg"
  widths={w}
  sizes={sizes}
  quality={quality}
  loading={eager ? 'eager' : 'lazy'}
  decoding={eager ? 'sync' : 'async'}
  fetchpriority={eager ? 'high' : undefined}
  class={cls}
  style={position ? `object-position:${position}` : undefined}
/>
