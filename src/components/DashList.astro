---
/* Hairline-ruled list with a 20px sand dash before each item (no bullets). */
interface Props {
  items: string[];
  compact?: boolean;
  class?: string;
  revealDelay?: number;
}
const { items, compact = false, class: cls, revealDelay } = Astro.props;
---
<ul class:list={['dash-list', compact && 'dash-list--compact', cls]} data-reveal={revealDelay !== undefined ? '' : undefined} data-reveal-delay={revealDelay || undefined}>
  {items.map((item) => <li><span class="dash-list__dash" aria-hidden="true"></span><span>{item}</span></li>)}
</ul>

<style>
  .dash-list {
    margin: 0;
    padding: 0;
    list-style: none;
    display: flex;
    flex-direction: column;
    border-top: 1px solid var(--border-sand);
    min-width: 0;
  }
  .dash-list li {
    margin: 0;
    display: flex;
    align-items: flex-start;
    gap: var(--space-4);
    padding: var(--space-5) 0;
    border-bottom: 1px solid var(--border-sand);
    font-size: var(--text-body);
    line-height: var(--leading-body);
    color: var(--c-ink-soft);
  }
  .dash-list__dash { flex: 0 0 auto; width: 20px; height: 1px; margin-top: 14px; background: var(--c-sand-deep); }
  .dash-list--compact li { padding: var(--space-4) 0; }
  .dash-list--compact .dash-list__dash { margin-top: 13px; }
</style>
