---
import '@fontsource/petrona/300.css';
import '@fontsource/petrona/400.css';
import '@fontsource/petrona/300-italic.css';
import '@fontsource/jost/300.css';
import '@fontsource/jost/400.css';
import '../styles/global.css';
import petrona300 from '@fontsource/petrona/files/petrona-latin-300-normal.woff2?url';
import jost300 from '@fontsource/jost/files/jost-latin-300-normal.woff2?url';
import jost400 from '@fontsource/jost/files/jost-latin-400-normal.woff2?url';

import type { ImageMetadata } from 'astro';
import { getImage } from 'astro:assets';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { SITE } from '../data/site';

interface Props {
  title: string;
  description: string;
  /** Page banner, used for the Open Graph / Twitter image (cropped to 1200×630). */
  ogImage: ImageMetadata;
  ogImageAlt: string;
  /** Home: header is transparent over the hero until the page scrolls. */
  transparentHeader?: boolean;
}

const { title, description, ogImage, ogImageAlt, transparentHeader = false } = Astro.props;
const canonical = new URL(Astro.url.pathname.replace(/\/$/, '') || '/', Astro.site);
const og = await getImage({ src: ogImage, width: 1200, height: 630, fit: 'cover', format: 'jpg', quality: 80 });
const ogUrl = new URL(og.src, Astro.site).href;

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': ['LocalBusiness', 'SportsActivityLocation'],
  '@id': new URL('/#business', Astro.site).href,
  name: SITE.name,
  description: 'Freediving courses, coaching, surf survival workshops and guided ocean excursions on Nemberala Beach, Rote Island, Indonesia.',
  url: new URL('/', Astro.site).href,
  image: ogUrl,
  logo: new URL('/icon-512.png', Astro.site).href,
  telephone: SITE.phoneE164,
  email: SITE.email,
  address: { '@type': 'PostalAddress', ...SITE.addressParts },
  hasMap: SITE.mapsUrl,
  sameAs: [SITE.instagramUrl],
};
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical.href} />
    <meta name="theme-color" content="#0B3348" />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={SITE.name} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical.href} />
    <meta property="og:image" content={ogUrl} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={ogImageAlt} />
    <meta property="og:locale" content="en" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogUrl} />

    <link rel="icon" href="/favicon.ico" sizes="48x48" />
    <link rel="icon" href="/favicon-32.png" type="image/png" sizes="32x32" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />

    <link rel="preload" href={jost300} as="font" type="font/woff2" crossorigin />
    <link rel="preload" href={jost400} as="font" type="font/woff2" crossorigin />
    <link rel="preload" href={petrona300} as="font" type="font/woff2" crossorigin />

    <script is:inline>
      // Arms the scroll reveal. If the reveal script never runs, show everything anyway.
      document.documentElement.classList.add('js');
      setTimeout(function () {
        if (!window.__revealReady) document.documentElement.classList.remove('js');
      }, 3000);
    </script>
    <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
  </head>
  <body>
    <div class="site">
      <a class="skip-link" href="#main">Skip to content</a>
      <Header transparent={transparentHeader} />
      <main id="main" tabindex="-1">
        <slot />
      </main>
      <Footer />
    </div>

    <script>
      import '../scripts/reveal';
    </script>
  </body>
</html>
